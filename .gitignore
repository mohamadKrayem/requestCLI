# Build output. Anchored to the repo root: an unanchored `rq` also matches the
# cmd/rq/ source directory and silently keeps the entry point out of git.
/rq
/echoserver
dist/

# Test and coverage artifacts
*.test
coverage.out
coverage.html

# Local environment
.env
.env.local

# Product strategy and design notes, kept local on purpose
VISION.md
M1-BRIEF.md

# Locally installed agent skills, not part of the project.
# Scoped to .claude/skills/ rather than all of .claude/ so project-local
# config (CLAUDE.md, shared commands) stays trackable.
.agents/
.claude/skills/
skills-lock.json

# Editor / OS noise
.idea/
.vscode/
.DS_Store
